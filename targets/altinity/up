#!/usr/bin/env bash
# targets/altinity/up <tier>: single entry point; dispatches on the tier manifest's deployment.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
tier="${1:?usage: targets/altinity/up <tier> (see targets/altinity/*.json)}"
man="$ROOT/targets/altinity/$tier.json"
[ -f "$man" ] || { echo "unknown tier $tier (no $man)" >&2; exit 2; }
dep=$(python3 -c "import json; print(json.load(open('$man'))['deployment'])")
case "$dep" in
  compose-*) exec "$ROOT/targets/compose/up" altinity "$tier" ;;
  kind-*)    exec "$ROOT/targets/kind/up" altinity "$tier" ;;
  aws-*)     exec "$ROOT/targets/aws/up" altinity "$tier" ;;
  *) echo "unknown deployment $dep" >&2; exit 2 ;;
esac
