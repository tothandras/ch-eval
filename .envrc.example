#!/usr/bin/env bash

eval "$(devenv direnvrc)"

# `use devenv` supports the same options as the `devenv shell` command.
#
# To silence all output, use `--quiet`.
#
# Example usage: use devenv --quiet --impure --option services.postgres.enable:bool true
use devenv

# ---------------------------------------------------------------------------
# ch-eval: copy this file to `.envrc` (git-ignored) and fill in secrets there.
# Never commit credentials or connection strings.
#
# Each target manifest (targets/<platform>/<tier>.json) names its DSN variable
# in `dsn_env`. Local tiers fall back to the passwordless `default` user on
# their first native port, so these are only needed to point a tier elsewhere:
# export CLICKHOUSE_DSN_ALTINITY_LOCAL_SINGLE="clickhouse://<user>:<password>@<host>:<port>/default"
# Paid tiers have no default (after approval only):
# export CLICKHOUSE_DSN_CLOUD="clickhouse://<user>:<password>@<host>:9440/default?secure=true"
# export CLICKHOUSE_CLOUD_API_KEY=...        # paid tier only, after approval
# export CLICKHOUSE_CLOUD_API_SECRET=...
# export CLICKHOUSE_CLOUD_ORG_ID=...
# export AWS_PROFILE=...                     # paid tier only, after approval
